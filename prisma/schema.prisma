// DMS Tech Business OS — Prisma schema
// Phase 1: identity, RBAC, sessions, organization settings, audit, activity,
// notifications, approvals, domain events. Later phases add their own models
// (see docs/BUSINESS-OS-ARCHITECTURE.md for the full target schema).
//
// Conventions
// - Every business table carries organizationId (multi-tenancy ready, single org today).
// - Soft delete via deletedAt where records are referenced by history.
// - Status columns are Postgres enums.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum Locale {
  ar
  en
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationCategory {
  AUTOMATION
  APPROVAL
  INTEGRATIONS
  MARKETING
  OPERATIONS
  SUPPORT
  TASK
  INVOICE
  PROJECT
  CONTRACT
  HR
  SALES
  SYSTEM
}

enum EventStatus {
  PENDING
  /// claimed by the recovery job (re-dispatch in progress)
  PROCESSING
  PROCESSED
  FAILED
  /// failed too many times — needs an operator (retry / dismiss)
  DEAD_LETTER
  DISMISSED
}

// ---------------------------------------------------------------------------
// Organization
// ---------------------------------------------------------------------------

model Organization {
  id                                 String   @id @default(cuid())
  slug                               String   @unique
  name                               String
  nameAr                             String?
  legalName                          String?
  vatNumber                          String?
  crNumber                           String?
  email                              String?
  phone                              String?
  address                            String?
  city                               String?
  country                            String   @default("SA")
  currency                           String   @default("SAR")
  /// VAT rate in percent (e.g. 15.00). Configurable — used by quotations/invoices from Phase 3.
  vatRate                            Decimal  @default(15) @db.Decimal(5, 2)
  timezone                           String   @default("Asia/Riyadh")
  defaultLocale                      Locale   @default(ar)
  /// Quotations above this amount require executive approval (Phase 3 rules).
  quoteApprovalThreshold             Decimal  @default(50000) @db.Decimal(14, 2)
  /// Discount percent above which manager approval is required (Phase 3 rules).
  discountApprovalPercent            Decimal  @default(10) @db.Decimal(5, 2)
  /// Quotations at/above this total need `sales.quotations.approve_executive` (null = no executive tier).
  quoteExecutiveApprovalThreshold    Decimal? @db.Decimal(14, 2)
  /// Lines priced away from the catalog (or custom lines) require approval when true.
  quoteCustomPricingRequiresApproval Boolean  @default(false)
  /// Default validity of a new quotation in days.
  quoteValidityDays                  Int      @default(30)
  /// Owner is warned this many days before a sent quotation expires.
  quoteExpiryWarningDays             Int      @default(3)
  /// Active contracts become EXPIRING this many days before their end date.
  contractExpiryWarningDays          Int      @default(30)
  /// Phase 4: allow creating a project straight from an accepted quotation (no contract)
  projectFromQuotationAllowed        Boolean  @default(false)
  /// Phase 4: allow INTERNAL projects without a client
  internalProjectsAllowed            Boolean  @default(false)
  /// Phase 4: maximum minutes one person may log per day (all projects)
  timesheetMaxDailyMinutes           Int      @default(720)
  /// Phase 4: a project without activity for this many days needs attention
  projectInactivityDays              Int      @default(14)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  users                      User[]
  roles                      Role[]
  departments                Department[]
  auditLogs                  AuditLog[]
  activities                 Activity[]
  notifications              Notification[]
  approvals                  Approval[]
  events                     DomainEvent[]
  /// Phase 5: default payment terms for new invoices (days after issue)
  invoiceDueDays             Int            @default(30)
  /// Phase 5: "due soon" reminder window (days)
  invoiceDueSoonDays         Int            @default(3)
  /// Phase 5: bank / IBAN / payment instructions printed on invoices (snapshotted at issue)
  invoicePaymentInstructions String?
  /// Phase 5: expenses at/above this total need finance.expenses.approve_executive
  expenseApprovalThreshold   Decimal        @default(5000) @db.Decimal(14, 2)
  /// Phase 5: outstanding balance per client above which the Command Center flags it
  largeOutstandingThreshold  Decimal        @default(50000) @db.Decimal(14, 2)
  /// Phase 5: suggested hourly rate for billing approved time (editable on the draft); null = enter manually
  defaultHourlyBillingRate   Decimal?       @db.Decimal(14, 2)
  /// Phase 8: WhatsApp campaigns with more recipients than this need approval (Approval CAMPAIGN)
  campaignApprovalThreshold  Int            @default(50)
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(cuid())
  organizationId     String
  email              String
  name               String
  nameAr             String?
  jobTitle           String?
  phone              String?
  avatarUrl          String?
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  locale             Locale     @default(ar)
  departmentId       String?
  mustChangePassword Boolean    @default(false)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department         Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[]   @relation("DepartmentManager")
  roles              UserRole[]
  sessions           Session[]
  notifications      Notification[]
  requestedApprovals Approval[]     @relation("ApprovalRequester")
  assignedApprovals  Approval[]     @relation("ApprovalAssignee")
  decidedApprovals   Approval[]     @relation("ApprovalDecider")
  activities         Activity[]
  auditLogs          AuditLog[]

  // CRM (Phase 2)
  ownedClients         Client[]              @relation("ClientOwner")
  createdClients       Client[]              @relation("ClientCreator")
  createdContacts      Contact[]             @relation("ContactCreator")
  ownedLeads           Lead[]                @relation("LeadOwner")
  createdLeads         Lead[]                @relation("LeadCreator")
  ownedOpportunities   Opportunity[]         @relation("OpportunityOwner")
  createdOpportunities Opportunity[]         @relation("OpportunityCreator")
  crmActivities        CrmActivity[]         @relation("CrmActivityCreator")
  crmNotes             CrmNote[]             @relation("CrmNoteAuthor")
  ownedQuotations      Quotation[]           @relation("QuotationOwner")
  createdQuotations    Quotation[]           @relation("QuotationCreator")
  ownedContracts       Contract[]            @relation("ContractOwner")
  createdContracts     Contract[]            @relation("ContractCreator")
  managedProjects      Project[]             @relation("ProjectManager")
  createdProjects      Project[]             @relation("ProjectCreator")
  projectMemberships   ProjectMember[]       @relation("ProjectMemberships")
  ownedMilestones      ProjectMilestone[]    @relation("MilestoneOwner")
  assignedTasks        Task[]                @relation("TaskAssignee")
  createdTasks         Task[]                @relation("TaskCreator")
  comments             Comment[]             @relation("CommentAuthor")
  timeEntries          TimeEntry[]           @relation("TimeEntryUser")
  timesheets           TimesheetSubmission[] @relation("TimesheetUser")
  ownedDeliverables    ProjectDeliverable[]  @relation("DeliverableOwner")
  savedViews           SavedView[]           @relation("UserSavedViews")

  invoicesCreated   Invoice[]               @relation("InvoiceCreator")
  paymentsCreated   Payment[]               @relation("PaymentCreator")
  expensesIncurred  Expense[]               @relation("ExpenseUser")
  expensesSubmitted Expense[]               @relation("ExpenseSubmitter")
  costRates         UserCostRate[]          @relation("CostRateUser")
  invoiceNotes      InvoiceCollectionNote[] @relation("InvoiceNoteAuthor")

  employee Employee? @relation("EmployeeUser")

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  nameAr         String?
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
}

model RolePermission {
  roleId     String
  /// Must be a key of the code catalog (src/server/rbac/permissions.ts) — validated in the service layer.
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model UserRole {
  userId      String
  roleId      String
  grantedById String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Database session. `id` is the SHA-256 of the random token held in the httpOnly cookie.
model Session {
  id         String    @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counters for sensitive endpoints (login). Works across serverless instances.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model Department {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  managerId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      User[]       @relation("DepartmentMembers")
  services     Service[]
  projects     Project[]

  expenses Expense[]

  employees   Employee[]
  jobOpenings JobOpening[]
  /// Phase 6: departments can be deactivated without deleting history
  active      Boolean      @default(true)

  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]
  knowledgeArticles   KnowledgeArticle[]

  @@unique([organizationId, code])
}

// ---------------------------------------------------------------------------
// Cross-cutting: audit, activity, notifications, approvals, events
// ---------------------------------------------------------------------------

/// Append-only. A database trigger rejects UPDATE and DELETE (see migration).
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  /// e.g. "user.created", "approval.approved"
  verb           String
  entityType     String
  entityId       String?
  entityLabel    String?
  href           String?
  /// Permission needed to see this item in the feed (null = everyone in the org).
  visibility     String?
  meta           Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model Notification {
  id             String               @id @default(cuid())
  organizationId String
  userId         String
  category       NotificationCategory
  priority       Priority             @default(MEDIUM)
  title          String
  body           String?
  href           String?
  entityType     String?
  entityId       String?
  readAt         DateTime?
  /// Optional idempotency key: the same reminder is never stored twice for a user (sweeps, retries)
  dedupeKey      String?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

/// Generic approval request. `type` selects a handler registered in src/server/approvals/handlers.ts
/// which applies the change when approved (e.g. ROLE_GRANT; later QUOTATION, EXPENSE, LEAVE, PO …).
model Approval {
  id                 String         @id @default(cuid())
  organizationId     String
  type               String
  entityType         String
  entityId           String
  title              String
  summary            String?
  payload            Json?
  amount             Decimal?       @db.Decimal(14, 2)
  currency           String?
  priority           Priority       @default(MEDIUM)
  /// Permission an approver must hold (in addition to approvals.decide).
  requiredPermission String
  status             ApprovalStatus @default(PENDING)
  requestedById      String
  assigneeId         String?
  decidedById        String?
  decidedAt          DateTime?
  decisionComment    String?
  dueAt              DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  assignee     User?        @relation("ApprovalAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId])
}

/// Outbox of domain events (lead.created, quotation.accepted, …). Subscribers run after commit.
model DomainEvent {
  id             String      @id @default(cuid())
  organizationId String
  type           String
  actorId        String?
  entityType     String?
  entityId       String?
  payload        Json
  status         EventStatus @default(PENDING)
  error          String?
  createdAt      DateTime    @default(now())
  processedAt    DateTime?
  /// Phase 9 reliability: dispatch attempts, handlers that already succeeded (skipped on retry), operator dismissal
  attempts       Int         @default(0)
  lastAttemptAt  DateTime?
  handlersDone   Json?
  dismissedAt    DateTime?
  dismissedById  String?
  dismissReason  String?
  /// Phase 9 tracing: the whole causal chain shares correlationId; causationId = the event that caused this one; depth = automation hops
  correlationId  String?
  causationId    String?
  depth          Int         @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([correlationId])
}

// ===========================================================================
// Phase 2 — CRM
// ===========================================================================

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  PHONE
  REFERRAL
  LINKEDIN
  INSTAGRAM
  GOOGLE_ADS
  META_ADS
  TIKTOK
  GOVERNMENT_OPPORTUNITY
  PARTNER
  MANUAL
  OTHER
}

/// Lifecycle outcome of a lead (what happened to it).
enum LeadStatus {
  OPEN
  QUALIFIED
  CONVERTED
  LOST
  ARCHIVED
}

/// Engagement stage while the lead is being worked (how far contact has progressed).
/// Deliberately separate from LeadStatus and from opportunity pipeline stages.
enum LeadStage {
  NEW
  ATTEMPTED
  CONTACTED
  ENGAGED
  UNRESPONSIVE
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum CrmEntity {
  LEAD
  CLIENT
  CONTACT
  OPPORTUNITY
}

enum CrmActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  TASK
  FOLLOW_UP
  STATUS_CHANGE
  SYSTEM
}

/// Concurrency-safe readable identifiers (LEAD-000001 ...): incremented with an atomic UPSERT ... RETURNING.
model Sequence {
  organizationId String
  key            String
  value          Int    @default(0)

  @@id([organizationId, key])
}

model Client {
  id                     String       @id @default(cuid())
  organizationId         String
  number                 String
  type                   ClientType   @default(COMPANY)
  displayName            String
  companyName            String?
  nameAr                 String?
  nameEn                 String?
  email                  String?
  emailNormalized        String?
  phone                  String?
  phoneNormalized        String?
  whatsapp               String?
  website                String?
  country                String?      @default("SA")
  city                   String?
  address                String?
  industry               String?
  taxNumber              String?
  commercialRegistration String?
  source                 LeadSource?
  ownerId                String?
  status                 ClientStatus @default(PROSPECT)
  notes                  String?
  createdById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  owner          User?         @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("ClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contacts       Contact[]
  opportunities  Opportunity[]
  convertedLeads Lead[]        @relation("LeadConvertedClient")
  quotations     Quotation[]
  contracts      Contract[]
  projects       Project[]

  invoices Invoice[]
  payments Payment[]

  supportTickets SupportTicket[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
}

/// Only one primary contact per client: enforced by a partial unique index in the migration.
model Contact {
  id                String    @id @default(cuid())
  organizationId    String
  clientId          String?
  firstName         String
  lastName          String?
  jobTitle          String?
  email             String?
  emailNormalized   String?
  phone             String?
  phoneNormalized   String?
  whatsapp          String?
  isPrimary         Boolean   @default(false)
  preferredLanguage Locale    @default(ar)
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  quotations    Quotation[]
  contracts     Contract[]

  invoices Invoice[]

  supportTickets SupportTicket[]

  @@index([organizationId, clientId])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
}

model Lead {
  id                 String     @id @default(cuid())
  organizationId     String
  number             String
  name               String
  companyName        String?
  email              String?
  emailNormalized    String?
  phone              String?
  phoneNormalized    String?
  whatsapp           String?
  whatsappNormalized String?
  country            String?
  city               String?
  source             LeadSource @default(MANUAL)
  /// Temporary typed service key (src/lib/crm/services.ts); migrates to a Service FK in Phase 3.
  /// Legacy Phase 2 service-category key. Kept for history and for values without a catalog match.
  interestedService  String?
  /// Phase 3 catalog link (backfilled from interestedService where the key matches Service.key).
  serviceId          String?
  budgetMin          Decimal?   @db.Decimal(14, 2)
  budgetMax          Decimal?   @db.Decimal(14, 2)
  currency           String     @default("SAR")
  ownerId            String?
  stage              LeadStage  @default(NEW)
  status             LeadStatus @default(OPEN)
  priority           Priority   @default(MEDIUM)
  nextFollowUpAt     DateTime?
  message            String?
  notes              String?
  locale             Locale?
  /// Website capture metadata: utm_*, referrer, form source (never shown publicly).
  captureMeta        Json?
  duplicateOfId      String?
  convertedAt        DateTime?
  convertedById      String?
  convertedClientId  String?
  lostAt             DateTime?
  lostReason         String?
  archivedAt         DateTime?
  lastActivityAt     DateTime?
  createdById        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  owner           User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User?        @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  convertedClient Client?      @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  duplicateOf     Lead?        @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates      Lead[]       @relation("LeadDuplicates")
  opportunity     Opportunity? @relation("OpportunitySourceLead")
  service         Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  attributionTouches AttributionTouch[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, ownerId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, whatsappNormalized])
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  nameAr         String
  nameEn         String
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([organizationId, key])
}

model PipelineStage {
  id                 String   @id @default(cuid())
  pipelineId         String
  key                String
  nameAr             String
  nameEn             String
  position           Int
  colorToken         String   @default("neutral")
  isWonStage         Boolean  @default(false)
  isLostStage        Boolean  @default(false)
  defaultProbability Int      @default(10)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, key])
  @@index([pipelineId, position])
}

model Opportunity {
  id                String            @id @default(cuid())
  organizationId    String
  number            String
  clientId          String
  primaryContactId  String?
  /// A lead converts into at most one opportunity (unique): also the double-conversion guard.
  sourceLeadId      String?           @unique
  title             String
  description       String?
  /// Legacy Phase 2 service-category key (see Lead.interestedService).
  serviceCategory   String?
  serviceId         String?
  estimatedValue    Decimal           @default(0) @db.Decimal(14, 2)
  currency          String            @default("SAR")
  probability       Int               @default(10)
  pipelineId        String
  stageId           String
  ownerId           String?
  expectedCloseDate DateTime?
  nextFollowUpAt    DateTime?
  status            OpportunityStatus @default(OPEN)
  lostReason        String?
  stageChangedAt    DateTime          @default(now())
  lastActivityAt    DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  wonAt             DateTime?
  lostAt            DateTime?
  archivedAt        DateTime?

  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  primaryContact Contact?      @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  sourceLead     Lead?         @relation("OpportunitySourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner          User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  quotations     Quotation[]
  contracts      Contract[]
  projects       Project[]

  @@unique([organizationId, number])
  @@index([organizationId, status, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, clientId])
  @@index([organizationId, nextFollowUpAt])
}

/// CRM timeline entry. isSystem separates generated entries (status changes, captures) from user-logged ones.
model CrmActivity {
  id             String          @id @default(cuid())
  organizationId String
  entityType     CrmEntity
  entityId       String
  /// Denormalised so the Client 360 timeline includes activity of its contacts and opportunities.
  clientId       String?
  type           CrmActivityType
  title          String
  description    String?
  isSystem       Boolean         @default(false)
  createdById    String?
  occurredAt     DateTime        @default(now())
  metadata       Json?
  createdAt      DateTime        @default(now())

  createdBy User? @relation("CrmActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([organizationId, clientId, occurredAt])
}

/// Internal notes. Never exposed to the public site.
model CrmNote {
  id             String    @id @default(cuid())
  organizationId String
  entityType     CrmEntity
  entityId       String
  clientId       String?
  body           String
  authorId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  author User? @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
}

model CrmTag {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  colorToken     String         @default("neutral")
  createdAt      DateTime       @default(now())
  entities       CrmEntityTag[]

  @@unique([organizationId, name])
}

model CrmEntityTag {
  tagId      String
  entityType CrmEntity
  entityId   String
  createdAt  DateTime  @default(now())
  tag        CrmTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

/// Per-user saved list filters (stores the URL query of a list view).
model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  module         String
  name           String
  query          String
  createdAt      DateTime @default(now())

  user User @relation("UserSavedViews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
}

// ---------------------------------------------------------------------------
// Phase 3 — Service catalog, quotations, contracts (docs/COMMERCIAL.md)
// ---------------------------------------------------------------------------

enum PricingModel {
  FIXED
  HOURLY
  MONTHLY
  ANNUAL
  PER_USER
  PER_UNIT
  CUSTOM
}

/// STANDARD = organization VAT rate at calculation time; ZERO_RATED / EXEMPT = 0%.
enum TaxBehavior {
  STANDARD
  ZERO_RATED
  EXEMPT
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum QuotationStatus {
  DRAFT
  INTERNAL_REVIEW
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  SUPERSEDED
}

enum SendMethod {
  EMAIL_MANUAL
  WHATSAPP_MANUAL
  IN_PERSON
  OTHER
}

enum ContractStatus {
  DRAFT
  INTERNAL_REVIEW
  AWAITING_SIGNATURE
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CommercialDocKind {
  QUOTATION_PDF
  CONTRACT_PDF
  INVOICE_PDF
}

/// Catalog entry. Source for insertion into quotations only — quotation items keep their own snapshot.
model Service {
  id                     String       @id @default(cuid())
  organizationId         String
  /// Readable code SRV-000001 (Sequence)
  code                   String
  /// Stable slug; matches the Phase 2 category keys / website service slugs for default services.
  key                    String?
  nameAr                 String
  nameEn                 String
  shortDescriptionAr     String?
  shortDescriptionEn     String?
  descriptionAr          String?
  descriptionEn          String?
  category               String?
  pricingModel           PricingModel @default(CUSTOM)
  basePrice              Decimal      @default(0) @db.Decimal(14, 2)
  currency               String       @default("SAR")
  taxBehavior            TaxBehavior  @default(STANDARD)
  estimatedDeliveryDays  Int?
  departmentId           String?
  active                 Boolean      @default(true)
  quotationDescriptionAr String?
  quotationDescriptionEn String?
  defaultTermsAr         String?
  defaultTermsEn         String?
  createdById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  archivedAt             DateTime?

  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  packageItems   ServicePackageItem[]
  quotationItems QuotationItem[]
  leads          Lead[]
  opportunities  Opportunity[]
  projects       Project[]
  templates      ProjectTemplate[]

  invoiceItems InvoiceItem[]

  supportTickets SupportTicket[]

  @@unique([organizationId, code])
  @@unique([organizationId, key])
  @@index([organizationId, active])
}

model ServicePackage {
  id             String      @id @default(cuid())
  organizationId String
  /// PKG-000001
  code           String
  nameAr         String
  nameEn         String
  descriptionAr  String?
  descriptionEn  String?
  active         Boolean     @default(true)
  defaultPrice   Decimal     @default(0) @db.Decimal(14, 2)
  currency       String      @default("SAR")
  taxBehavior    TaxBehavior @default(STANDARD)
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  archivedAt     DateTime?

  items          ServicePackageItem[]
  quotationItems QuotationItem[]

  @@unique([organizationId, code])
}

model ServicePackageItem {
  id        String  @id @default(cuid())
  packageId String
  serviceId String
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  optional  Boolean @default(false)
  sortOrder Int     @default(0)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([packageId, serviceId])
}

/// A commercial proposal (one number, e.g. Q-2026-000012). Its content lives in versions that freeze once they leave DRAFT.
model Quotation {
  id                String          @id @default(cuid())
  organizationId    String
  number            String
  clientId          String
  contactId         String?
  opportunityId     String?
  /// Sales owner (record scope ALL / TEAM / OWN applies on this field)
  ownerId           String?
  /// Mirrors the current version's status (lists, filters, uniqueness).
  status            QuotationStatus @default(DRAFT)
  currentVersionId  String?         @unique
  acceptedVersionId String?         @unique
  /// Set when created with "Duplicate" (a separate proposal with its own number).
  duplicatedFromId  String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact        Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity    Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner          User?              @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  currentVersion QuotationVersion?  @relation("QuotationCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       QuotationVersion[] @relation("QuotationVersions")
  contracts      Contract[]
  projects       Project[]

  invoices Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, opportunityId])
  @@index([organizationId, ownerId])
}

/// One version of a quotation. Commercial columns and items are frozen by DB triggers once it leaves DRAFT
/// (migration phase3_commercial); a change after sending means a new version (revision).
model QuotationVersion {
  id                    String          @id @default(cuid())
  organizationId        String
  quotationId           String
  versionNumber         Int
  status                QuotationStatus @default(DRAFT)
  language              Locale          @default(ar)
  currency              String          @default("SAR")
  issueDate             DateTime        @db.Date
  validUntil            DateTime        @db.Date
  /// Organization VAT rate captured when totals were calculated
  vatRate               Decimal         @db.Decimal(5, 2)
  subtotal              Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal         @default(0) @db.Decimal(14, 2)
  total                 Decimal         @default(0) @db.Decimal(14, 2)
  paymentTerms          String?
  deliveryTerms         String?
  termsAndConditions    String?
  /// Internal only — never printed
  notes                 String?
  clientMessage         String?
  /// sha256 of the commercial content; set on submit, re-verified on approval
  contentHash           String?
  approvalRequired      Boolean         @default(false)
  approvalReasons       Json?
  approvalId            String?
  approvalComment       String?
  submittedAt           DateTime?
  submittedById         String?
  approvedAt            DateTime?
  approvedById          String?
  sentAt                DateTime?
  sentById              String?
  sendMethod            SendMethod?
  sentNote              String?
  viewedAt              DateTime?
  acceptedAt            DateTime?
  acceptedRecordedById  String?
  acceptanceNote        String?
  rejectedAt            DateTime?
  rejectionReason       String?
  rejectionRecordedById String?
  expiredAt             DateTime?
  expiringNotifiedAt    DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  supersededAt          DateTime?
  revisedFromId         String?
  createdById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  quotation Quotation            @relation("QuotationVersions", fields: [quotationId], references: [id], onDelete: Cascade)
  currentOf Quotation?           @relation("QuotationCurrentVersion")
  items     QuotationItem[]
  documents CommercialDocument[]
  contracts Contract[]
  projects  Project[]

  invoices Invoice[]

  @@unique([quotationId, versionNumber])
  @@index([organizationId, status, validUntil])
}

/// Historical commercial snapshot of a line. Never re-read from the catalog after insertion.
model QuotationItem {
  id               String       @id @default(cuid())
  versionId        String
  sortOrder        Int          @default(0)
  serviceId        String?
  packageId        String?
  name             String
  description      String?
  unit             String?
  quantity         Decimal      @db.Decimal(12, 3)
  unitPrice        Decimal      @db.Decimal(14, 2)
  /// Catalog price when the line was saved (null for custom lines)
  catalogUnitPrice Decimal?     @db.Decimal(14, 2)
  discountType     DiscountType @default(NONE)
  discountValue    Decimal      @default(0) @db.Decimal(14, 2)
  grossAmount      Decimal      @db.Decimal(14, 2)
  discountAmount   Decimal      @db.Decimal(14, 2)
  /// Net line amount after discount, before tax
  subtotal         Decimal      @db.Decimal(14, 2)
  taxBehavior      TaxBehavior  @default(STANDARD)
  taxRate          Decimal      @db.Decimal(5, 2)
  taxAmount        Decimal      @db.Decimal(14, 2)
  total            Decimal      @db.Decimal(14, 2)

  version QuotationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  service Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package ServicePackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([versionId, sortOrder])
}

/// Generated file kept as the exact artifact (e.g. the PDF of a sent version). Append-only (DB trigger).
model CommercialDocument {
  id                 String            @id @default(cuid())
  organizationId     String
  kind               CommercialDocKind
  quotationVersionId String?
  contractId         String?
  language           Locale
  fileName           String
  mimeType           String            @default("application/pdf")
  sha256             String
  size               Int
  data               Bytes
  createdById        String?
  createdAt          DateTime          @default(now())

  quotationVersion QuotationVersion? @relation(fields: [quotationVersionId], references: [id], onDelete: Restrict)
  contract         Contract?         @relation(fields: [contractId], references: [id], onDelete: Restrict)

  /// Phase 5: issued invoice artifact
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([quotationVersionId])
  @@index([contractId])
  @@index([invoiceId])
}

model Contract {
  id                 String         @id @default(cuid())
  organizationId     String
  /// CTR-2026-000001
  number             String
  clientId           String
  contactId          String?
  opportunityId      String?
  quotationId        String?
  /// Exact accepted version this contract was created from
  quotationVersionId String?
  title              String
  status             ContractStatus @default(DRAFT)
  language           Locale         @default(ar)
  startDate          DateTime?      @db.Date
  endDate            DateTime?      @db.Date
  renewalDate        DateTime?      @db.Date
  currency           String         @default("SAR")
  subtotal           Decimal        @default(0) @db.Decimal(14, 2)
  discountTotal      Decimal        @default(0) @db.Decimal(14, 2)
  taxTotal           Decimal        @default(0) @db.Decimal(14, 2)
  contractValue      Decimal        @default(0) @db.Decimal(14, 2)
  paymentTerms       String?
  scopeOfWork        String?
  terms              String?
  ownerId            String?
  signedAt           DateTime?
  activatedAt        DateTime?
  activatedById      String?
  terminatedAt       DateTime?
  terminationReason  String?
  cancelledAt        DateTime?
  cancelReason       String?
  expiredAt          DateTime?
  expiringNotifiedAt DateTime?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client           Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact          Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity      Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quotation        Quotation?           @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationVersion QuotationVersion?    @relation(fields: [quotationVersionId], references: [id], onDelete: Restrict)
  owner            User?                @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy        User?                @relation("ContractCreator", fields: [createdById], references: [id], onDelete: SetNull)
  milestones       ContractMilestone[]
  documents        CommercialDocument[]
  projects         Project[]

  invoices Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status, endDate])
  @@index([organizationId, clientId])
  @@index([organizationId, ownerId])
}

/// Commercial / delivery commitment of a contract (not a project task — that is Phase 4).
model ContractMilestone {
  id          String          @id @default(cuid())
  contractId  String
  title       String
  description String?
  amount      Decimal?        @db.Decimal(14, 2)
  percentage  Decimal?        @db.Decimal(5, 2)
  dueDate     DateTime?       @db.Date
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contract          Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  projectMilestones ProjectMilestone[]

  invoices Invoice[]

  @@index([contractId, sortOrder])
}

// ---------------------------------------------------------------------------
// Phase 4 — Project delivery, tasks, milestones, team, time (docs/PROJECTS.md)
// ---------------------------------------------------------------------------

enum ProjectType {
  CLIENT
  INTERNAL
}

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  WAITING_CLIENT
  BLOCKED
  AT_RISK
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectHealth {
  HEALTHY
  NEEDS_ATTENTION
  AT_RISK
}

/// Summary of client-side dependencies (derived, stored for lists and filters).
enum ClientDependencyState {
  NONE
  OPEN
  OVERDUE
}

enum ProjectMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum ProjectRole {
  PROJECT_MANAGER
  TECH_LEAD
  DEVELOPER
  DESIGNER
  MARKETING
  QA
  ACCOUNT_MANAGER
  CONTRIBUTOR
  OBSERVER
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TimesheetStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum DeliverableStatus {
  DRAFT
  IN_PROGRESS
  READY
  DELIVERED
  ACCEPTED
  REJECTED
}

enum ClientApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum DependencyType {
  CONTENT
  BRAND_ASSETS
  ACCESS
  CREDENTIALS
  DATA
  APPROVAL
  FEEDBACK
  OTHER
}

enum DependencySide {
  CLIENT
  INTERNAL
  THIRD_PARTY
}

enum DependencyStatus {
  OPEN
  WAITING
  RESOLVED
  CANCELLED
}

enum CommentEntity {
  TASK
  PROJECT
}

/// Operational delivery project. Commercial context is COPIED at creation (snapshot); the
/// project never reads live service descriptions or prices.
model Project {
  id                     String                @id @default(cuid())
  organizationId         String
  /// PRJ-YYYY-NNNNNN
  number                 String
  type                   ProjectType           @default(CLIENT)
  clientId               String?
  opportunityId          String?
  quotationId            String?
  quotationVersionId     String?
  contractId             String?
  serviceId              String?
  templateId             String?
  name                   String
  description            String?
  scopeSummary           String?
  deliveryTerms          String?
  projectManagerId       String?
  departmentId           String?
  status                 ProjectStatus         @default(PLANNING)
  statusReason           String?
  priority               Priority              @default(MEDIUM)
  startDate              DateTime?             @db.Date
  targetEndDate          DateTime?             @db.Date
  startedAt              DateTime?
  completedAt            DateTime?
  completedById          String?
  completionOverride     String?
  cancelledAt            DateTime?
  /// Commercial value copied from the contract / accepted version (net, excl. VAT). Commercial visibility only.
  budgetAmount           Decimal?              @db.Decimal(14, 2)
  currency               String                @default("SAR")
  /// 0–100, derived from weighted milestones (see docs/PROJECTS.md); never typed by hand
  progress               Int                   @default(0)
  health                 ProjectHealth         @default(HEALTHY)
  healthReasons          Json?
  healthCheckedAt        DateTime?
  atRiskNotifiedAt       DateTime?
  clientDependencyStatus ClientDependencyState @default(NONE)
  lastActivityAt         DateTime              @default(now())
  createdById            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  archivedAt             DateTime?

  client           Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  opportunity      Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  quotation        Quotation?            @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationVersion QuotationVersion?     @relation(fields: [quotationVersionId], references: [id], onDelete: Restrict)
  contract         Contract?             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  service          Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  template         ProjectTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  projectManager   User?                 @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  department       Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy        User?                 @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  milestones       ProjectMilestone[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  timesheets       TimesheetSubmission[]
  deliverables     ProjectDeliverable[]
  dependencies     ProjectDependency[]

  invoices Invoice[]
  expenses Expense[]

  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]
  supportTickets      SupportTicket[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, health])
  @@index([organizationId, projectManagerId])
  @@index([organizationId, clientId])
}

/// Project responsibility (NOT a permission — RBAC still decides what a user may do).
model ProjectMember {
  id                String      @id @default(cuid())
  projectId         String
  userId            String
  role              ProjectRole @default(CONTRIBUTOR)
  /// Declared allocation only (no capacity calendar)
  allocationPercent Int?
  joinedAt          DateTime    @default(now())
  leftAt            DateTime?
  addedById         String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, leftAt])
}

/// Operational delivery checkpoint (different from a commercial ContractMilestone; may reference one).
model ProjectMilestone {
  id                  String                 @id @default(cuid())
  projectId           String
  title               String
  description         String?
  status              ProjectMilestoneStatus @default(NOT_STARTED)
  startDate           DateTime?              @db.Date
  dueDate             DateTime               @db.Date
  completedAt         DateTime?
  ownerId             String?
  /// Relative weight for progress (1–100)
  weight              Int                    @default(10)
  /// Required milestones must be completed (or cancelled) before the project can complete
  required            Boolean                @default(true)
  blockedReason       String?
  sortOrder           Int                    @default(0)
  contractMilestoneId String?
  overdueNotifiedAt   DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner             User?                @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contractMilestone ContractMilestone?   @relation(fields: [contractMilestoneId], references: [id], onDelete: SetNull)
  tasks             Task[]
  deliverables      ProjectDeliverable[]

  @@index([projectId, sortOrder])
  @@index([status, dueDate])
}

model Task {
  id                String     @id @default(cuid())
  organizationId    String
  /// TASK-000001
  number            String
  projectId         String
  milestoneId       String?
  /// One level of subtasks (a subtask cannot have subtasks) — no cycles possible
  parentTaskId      String?
  title             String
  description       String?
  status            TaskStatus @default(TODO)
  priority          Priority   @default(MEDIUM)
  assigneeId        String?
  createdById       String?
  startDate         DateTime?  @db.Date
  dueDate           DateTime?  @db.Date
  completedAt       DateTime?
  estimateMinutes   Int?
  blockedReason     String?
  sortOrder         Int        @default(0)
  statusChangedAt   DateTime   @default(now())
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  archivedAt        DateTime?

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent      Task?             @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks    Task[]            @relation("Subtasks")
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@unique([organizationId, number])
  @@index([projectId, status, sortOrder])
  @@index([assigneeId, status])
  @@index([organizationId, dueDate])
}

/// Reusable internal comments (tasks today, projects too). Soft delete.
model Comment {
  id             String        @id @default(cuid())
  organizationId String
  entityType     CommentEntity
  entityId       String
  authorId       String?
  body           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  author User? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

model TimeEntry {
  id              String          @id @default(cuid())
  organizationId  String
  projectId       String
  taskId          String?
  userId          String
  date            DateTime        @db.Date
  minutes         Int
  description     String?
  billable        Boolean         @default(true)
  status          TimeEntryStatus @default(DRAFT)
  submissionId    String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task       Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user       User                 @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  submission TimesheetSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  invoiceLinks InvoiceTimeEntry[]

  @@index([userId, date])
  @@index([projectId, status])
}

/// A batch of time entries submitted for approval (decided through the Phase 1 approval engine).
model TimesheetSubmission {
  id             String          @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  status         TimesheetStatus @default(SUBMITTED)
  periodStart    DateTime        @db.Date
  periodEnd      DateTime        @db.Date
  totalMinutes   Int
  approvalId     String?
  decidedById    String?
  decidedAt      DateTime?
  reason         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User        @relation("TimesheetUser", fields: [userId], references: [id], onDelete: Restrict)
  entries TimeEntry[]

  @@index([projectId, status])
}

model ProjectDeliverable {
  id                     String               @id @default(cuid())
  projectId              String
  milestoneId            String?
  name                   String
  description            String?
  status                 DeliverableStatus    @default(DRAFT)
  dueDate                DateTime?            @db.Date
  ownerId                String?
  required               Boolean              @default(true)
  clientApprovalRequired Boolean              @default(false)
  clientApprovalStatus   ClientApprovalStatus @default(NOT_REQUIRED)
  deliveredAt            DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  clientDecisionNote     String?
  clientDecisionById     String?
  readyNotifiedAt        DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  owner     User?             @relation("DeliverableOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

/// Things the project waits for (client logo, content, API access, credentials, approvals …).
model ProjectDependency {
  id                String           @id @default(cuid())
  projectId         String
  title             String
  description       String?
  type              DependencyType   @default(OTHER)
  ownerSide         DependencySide   @default(CLIENT)
  status            DependencyStatus @default(OPEN)
  /// Critical dependencies justify WAITING_CLIENT and weigh on health
  critical          Boolean          @default(false)
  requestedAt       DateTime         @default(now())
  dueDate           DateTime?        @db.Date
  resolvedAt        DateTime?
  resolvedById      String?
  resolutionNote    String?
  overdueNotifiedAt DateTime?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([status, dueDate])
}

/// Starting point for a project; applying it creates independent snapshot milestones/tasks.
model ProjectTemplate {
  id             String   @id @default(cuid())
  organizationId String
  /// Stable code (e.g. "website")
  code           String
  nameAr         String
  nameEn         String
  descriptionAr  String?
  descriptionEn  String?
  serviceId      String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service    Service?                   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  milestones ProjectTemplateMilestone[]
  tasks      ProjectTemplateTask[]
  projects   Project[]

  @@unique([organizationId, code])
}

model ProjectTemplateMilestone {
  id         String @id @default(cuid())
  templateId String
  key        String
  titleAr    String
  titleEn    String
  weight     Int    @default(10)
  /// Due date = project start + offsetDays
  offsetDays Int    @default(7)
  sortOrder  Int    @default(0)

  template ProjectTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    ProjectTemplateTask[]

  @@unique([templateId, key])
}

model ProjectTemplateTask {
  id              String       @id @default(cuid())
  templateId      String
  milestoneId     String?
  titleAr         String
  titleEn         String
  estimateMinutes Int?
  /// Suggested project role for assignment
  role            ProjectRole?
  sortOrder       Int          @default(0)

  template  ProjectTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  milestone ProjectTemplateMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

/// Short-lived lease so scheduled sweeps run on ONE instance at a time (multi-instance safe).
model JobLease {
  key         String   @id
  holder      String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 5 — Finance: invoices, payments, expenses, vendors, cost rates
// Operational finance (billing, collection, cost) — NOT a general ledger.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum InvoiceSource {
  CONTRACT
  CONTRACT_MILESTONE
  QUOTATION
  PROJECT
  TIME
  MANUAL
}

enum InvoiceSendMethod {
  EMAIL_MANUAL
  WHATSAPP_MANUAL
  IN_PERSON
  PORTAL_MANUAL
  OTHER
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  PAYMENT_GATEWAY
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum VendorStatus {
  ACTIVE
  ARCHIVED
}

enum CollectionNoteKind {
  NOTE
  REMINDER
  PROMISE_TO_PAY
}

enum CollectionChannel {
  EMAIL
  PHONE
  WHATSAPP
  IN_PERSON
  OTHER
}

/// Customer invoice. Commercial content is editable only in DRAFT; from ISSUED on it is frozen
/// (service + DB trigger). Numbers (INV-YYYY-NNNNNN) are assigned at issue.
model Invoice {
  id                  String             @id @default(cuid())
  organizationId      String
  number              String?
  sourceType          InvoiceSource      @default(MANUAL)
  clientId            String
  contactId           String?
  quotationId         String?
  quotationVersionId  String?
  contractId          String?
  projectId           String?
  contractMilestoneId String?
  language            Locale             @default(ar)
  currency            String             @default("SAR")
  status              InvoiceStatus      @default(DRAFT)
  issueDate           DateTime           @db.Date
  dueDate             DateTime           @db.Date
  subtotal            Decimal            @default(0) @db.Decimal(14, 2)
  discountTotal       Decimal            @default(0) @db.Decimal(14, 2)
  taxTotal            Decimal            @default(0) @db.Decimal(14, 2)
  total               Decimal            @default(0) @db.Decimal(14, 2)
  paidAmount          Decimal            @default(0) @db.Decimal(14, 2)
  balanceDue          Decimal            @default(0) @db.Decimal(14, 2)
  paymentTerms        String?
  notes               String?
  /// Snapshots taken at issue — the PDF of an issued invoice never reads current client/company data
  paymentInstructions String?
  sellerSnapshot      Json?
  buyerSnapshot       Json?
  contentHash         String?
  /// Corrective re-issue of a voided invoice
  replacesInvoiceId   String?
  createdById         String?
  issuedById          String?
  issuedAt            DateTime?
  sentById            String?
  sentAt              DateTime?
  sentMethod          InvoiceSendMethod?
  paidAt              DateTime?
  cancelledAt         DateTime?
  cancelledById       String?
  cancelReason        String?
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?
  nextFollowUpAt      DateTime?          @db.Date
  lastReminderAt      DateTime?
  dueSoonNotifiedAt   DateTime?
  overdueNotifiedAt   DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact           Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quotation         Quotation?              @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  quotationVersion  QuotationVersion?       @relation(fields: [quotationVersionId], references: [id], onDelete: Restrict)
  contract          Contract?               @relation(fields: [contractId], references: [id], onDelete: Restrict)
  project           Project?                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  contractMilestone ContractMilestone?      @relation(fields: [contractMilestoneId], references: [id], onDelete: Restrict)
  createdBy         User?                   @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  allocations       PaymentAllocation[]
  timeLinks         InvoiceTimeEntry[]
  documents         CommercialDocument[]
  collectionNotes   InvoiceCollectionNote[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, clientId])
  @@index([projectId])
  @@index([contractId])
}

/// Invoice line — all amounts computed on the server (src/lib/commercial/calc.ts); tax rate snapshotted per line.
model InvoiceItem {
  id             String       @id @default(cuid())
  invoiceId      String
  sortOrder      Int          @default(0)
  description    String
  serviceId      String?
  projectId      String?
  unit           String?
  quantity       Decimal      @db.Decimal(12, 3)
  unitPrice      Decimal      @db.Decimal(14, 2)
  discountType   DiscountType @default(NONE)
  discountValue  Decimal      @default(0) @db.Decimal(14, 2)
  grossAmount    Decimal      @db.Decimal(14, 2)
  discountAmount Decimal      @db.Decimal(14, 2)
  /// net after discount, before tax
  subtotal       Decimal      @db.Decimal(14, 2)
  taxBehavior    TaxBehavior  @default(STANDARD)
  taxRate        Decimal      @db.Decimal(5, 2)
  taxAmount      Decimal      @db.Decimal(14, 2)
  total          Decimal      @db.Decimal(14, 2)

  invoice   Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service   Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  timeLinks InvoiceTimeEntry[]

  @@index([invoiceId, sortOrder])
}

/// Exact linkage of approved billable time to an invoice. A time entry can be linked to at most
/// one live invoice (partial unique index on timeEntryId WHERE releasedAt IS NULL); cancelling or
/// voiding the invoice releases the link and the time becomes billable again.
model InvoiceTimeEntry {
  id            String    @id @default(cuid())
  invoiceId     String
  invoiceItemId String?
  timeEntryId   String
  minutes       Int
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  invoice   Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  timeEntry TimeEntry    @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([timeEntryId])
}

/// Manual collection activity (no email/WhatsApp is sent by the system).
model InvoiceCollectionNote {
  id          String             @id @default(cuid())
  invoiceId   String
  kind        CollectionNoteKind @default(NOTE)
  channel     CollectionChannel?
  note        String
  followUpAt  DateTime?          @db.Date
  createdById String?
  createdAt   DateTime           @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("InvoiceNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
}

/// Money received from a client. Must be fully allocated to open invoices of that client
/// (no unallocated credit in Phase 5). Never deleted — reversed with a reason.
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  /// PAY-YYYY-NNNNNN
  number         String
  clientId       String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("SAR")
  paymentDate    DateTime      @db.Date
  method         PaymentMethod
  reference      String?
  notes          String?
  status         PaymentStatus @default(RECORDED)
  /// client-generated key: a resubmitted form can never record the same payment twice
  idempotencyKey String?
  createdById    String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, paymentDate])
  @@index([organizationId, clientId])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model ExpenseCategory {
  id             String    @id @default(cuid())
  organizationId String
  key            String
  nameAr         String
  nameEn         String
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expenses       Expense[]

  @@unique([organizationId, key])
}

model Vendor {
  id             String       @id @default(cuid())
  organizationId String
  /// VEN-000001
  number         String
  name           String
  contactName    String?
  phone          String?
  email          String?
  taxNumber      String?
  category       String?
  paymentTerms   String?
  status         VendorStatus @default(ACTIVE)
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  expenses       Expense[]

  /// Phase 7: operational procurement profile
  procurementCategory String?
  preferred           Boolean              @default(false)
  rating              Int?
  leadTimeDays        Int?
  contractReference   String?
  contacts            VendorContact[]
  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]
  assets              Asset[]
  maintenance         AssetMaintenance[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

/// Company spending. Approval goes through the Phase 1 engine (Approval type EXPENSE).
model Expense {
  id               String         @id @default(cuid())
  organizationId   String
  /// EXP-YYYY-NNNNNN
  number           String
  categoryId       String
  vendorId         String?
  projectId        String?
  departmentId     String?
  /// employee who incurred it (reimbursement) — defaults to the submitter
  userId           String?
  date             DateTime       @db.Date
  /// net amount before VAT
  amount           Decimal        @db.Decimal(14, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(14, 2)
  total            Decimal        @db.Decimal(14, 2)
  currency         String         @default("SAR")
  paymentMethod    PaymentMethod?
  description      String
  reference        String?
  status           ExpenseStatus  @default(DRAFT)
  submittedById    String
  submittedAt      DateTime?
  approvalId       String?
  approvedById     String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  paidAt           DateTime?
  paidById         String?
  paymentReference String?
  cancelledAt      DateTime?
  cancelReason     String?
  payReminderAt    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor      Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  department  Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user        User?           @relation("ExpenseUser", fields: [userId], references: [id], onDelete: SetNull)
  submittedBy User            @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  /// Phase 7: optional link to the purchase order it pays for (set at creation; history never rewritten)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([projectId])
  @@index([organizationId, date])
}

/// Internal costing metadata (NOT payroll): hourly cost of a person for project costing.
/// Restricted to finance.cost_rates.*; never shown to project members.
model UserCostRate {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  hourlyCost     Decimal   @db.Decimal(14, 2)
  currency       String    @default("SAR")
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  createdById    String?
  createdAt      DateTime  @default(now())

  user User @relation("CostRateUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Phase 6 — People operations: employees, compensation, bank, attendance, leave,
// payroll, recruitment, performance. Sensitive data lives in separate tables.
// ---------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
  TEMPORARY
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  TERMINATED
  ARCHIVED
}

/// HR person / employment record. Separate from authentication (User); a User link is optional.
model Employee {
  id                    String           @id @default(cuid())
  organizationId        String
  /// EMP-000001
  number                String
  userId                String?          @unique
  firstName             String
  lastName              String
  nameAr                String?
  displayName           String
  workEmail             String?
  personalEmail         String?
  workPhone             String?
  personalPhone         String?
  jobTitle              String?
  departmentId          String?
  managerId             String?
  employmentType        EmploymentType   @default(FULL_TIME)
  status                EmploymentStatus @default(PROBATION)
  joinDate              DateTime         @db.Date
  probationEndDate      DateTime?        @db.Date
  terminationDate       DateTime?        @db.Date
  terminationReason     String?
  accessRevokedAt       DateTime?
  workLocation          String?
  country               String           @default("SA")
  city                  String?
  nationality           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  archivedAt            DateTime?

  user               User?                  @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  department         Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager            Employee?              @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports            Employee[]             @relation("EmployeeManager")
  compensations      EmployeeCompensation[]
  bankAccounts       EmployeeBankAccount[]
  attendance         AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  leaveLedger        LeaveLedgerEntry[]
  payrollEntries     PayrollEntry[]
  payrollAdjustments PayrollAdjustment[]
  reviews            PerformanceReview[]
  goals              PerformanceGoal[]
  hiredFrom          Application[]          @relation("HiredEmployee")
  offers             Offer[]                @relation("OfferEmployee")

  assetAssignments AssetAssignment[]
  assignedAssets   Asset[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([managerId])
}

/// Protected salary history (hr.compensation.*). Rows are never edited: a new row closes the open one.
model EmployeeCompensation {
  id                  String    @id @default(cuid())
  organizationId      String
  employeeId          String
  baseSalary          Decimal   @db.Decimal(14, 2)
  housingAllowance    Decimal   @default(0) @db.Decimal(14, 2)
  transportAllowance  Decimal   @default(0) @db.Decimal(14, 2)
  otherFixedAllowance Decimal   @default(0) @db.Decimal(14, 2)
  currency            String    @default("SAR")
  effectiveFrom       DateTime  @db.Date
  effectiveTo         DateTime? @db.Date
  notes               String?
  createdById         String?
  createdAt           DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

/// Highly restricted bank details (hr.bank.*). History-only, masked unless revealed by an authorised user (audited).
model EmployeeBankAccount {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  bankName       String
  /// DEPRECATED (Phase 10): plaintext IBAN — null once encrypted (npm run hr:encrypt-iban). Never written by new code.
  iban           String?
  /// Phase 10: AES-256-GCM with HR_FIELD_KEY (separate from the integration key); last 4 digits kept for masking
  ibanCiphertext String?
  ibanIv         String?
  ibanTag        String?
  ibanKeyVersion Int?
  ibanLast4      String?
  accountName    String
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  createdById    String?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

/// One per organization; every value is configuration (nothing statutory is hard-coded).
model AttendancePolicy {
  id                       String   @id @default(cuid())
  organizationId           String   @unique
  workdayStart             String   @default("09:00")
  workdayEnd               String   @default("17:00")
  graceMinutes             Int      @default(15)
  /// 0 = Sunday … 6 = Saturday
  workingDays              Int[]    @default([0, 1, 2, 3, 4])
  dailyExpectedMinutes     Int      @default(480)
  /// approved leave marks attendance ON_LEAVE (future / open days only)
  leaveMarksAttendance     Boolean  @default(true)
  /// leave needs a second HR approval after the manager
  leaveRequiresHrApproval  Boolean  @default(false)
  /// payroll deducts approved UNPAID leave days (off by default — explicit policy)
  payrollDeductUnpaidLeave Boolean  @default(false)
  /// payroll prorates salary for joiners / leavers by calendar days
  payrollProrate           Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model CompanyHoliday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  name           String
  nameAr         String?
  location       String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  REMOTE
  ON_LEAVE
  HOLIDAY
  MISSING
}

enum AttendanceSource {
  MANUAL
  SELF
  LEAVE
  SYSTEM
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus
  workMinutes    Int?
  source         AttendanceSource @default(MANUAL)
  notes          String?
  correctedAt    DateTime?
  correctedById  String?
  createdById    String?
  notifiedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

model LeaveType {
  id                 String   @id @default(cuid())
  organizationId     String
  key                String
  nameAr             String
  nameEn             String
  paid               Boolean  @default(true)
  requiresAttachment Boolean  @default(false)
  requiresApproval   Boolean  @default(true)
  /// yearly balance granted when configured (null = no balance tracking)
  defaultBalanceDays Decimal? @db.Decimal(6, 2)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  requests LeaveRequest[]
  ledger   LeaveLedgerEntry[]

  @@unique([organizationId, key])
}

enum LeaveLedgerKind {
  OPENING
  ACCRUAL
  USAGE
  ADJUSTMENT
  REVERSAL
}

/// Append-only leave balance ledger. Balance = Σ days (usage is negative).
model LeaveLedgerEntry {
  id             String          @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  year           Int
  kind           LeaveLedgerKind
  days           Decimal         @db.Decimal(6, 2)
  leaveRequestId String?
  reason         String?
  createdById    String?
  createdAt      DateTime        @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  @@index([employeeId, leaveTypeId, year])
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id              String      @id @default(cuid())
  organizationId  String
  employeeId      String
  leaveTypeId     String
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  days            Decimal     @db.Decimal(6, 2)
  reason          String?
  status          LeaveStatus @default(DRAFT)
  /// approval stage: MANAGER → (optional) HR
  stage           String?
  approvalId      String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  cancelledAt     DateTime?
  cancelReason    String?
  startNotifiedAt DateTime?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee  Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  ledger    LeaveLedgerEntry[]

  @@index([organizationId, status])
  @@index([employeeId, startDate])
}

enum PayrollComponentKind {
  EARNING
  DEDUCTION
}

model PayrollComponent {
  id             String               @id @default(cuid())
  organizationId String
  key            String
  nameAr         String
  nameEn         String
  kind           PayrollComponentKind
  /// system components map to compensation fields and cannot be renamed by key
  system         Boolean              @default(false)
  active         Boolean              @default(true)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())

  adjustments PayrollAdjustment[]

  @@unique([organizationId, key])
}

enum PayrollStatus {
  DRAFT
  CALCULATING
  REVIEW
  APPROVED
  PAID
  CLOSED
}

model PayrollPeriod {
  id               String        @id @default(cuid())
  organizationId   String
  name             String
  periodStart      DateTime      @db.Date
  periodEnd        DateTime      @db.Date
  payDate          DateTime      @db.Date
  status           PayrollStatus @default(DRAFT)
  currency         String        @default("SAR")
  employeeCount    Int           @default(0)
  grossTotal       Decimal       @default(0) @db.Decimal(16, 2)
  deductionTotal   Decimal       @default(0) @db.Decimal(16, 2)
  netTotal         Decimal       @default(0) @db.Decimal(16, 2)
  preparedById     String?
  calculatedAt     DateTime?
  calculatedById   String?
  approvalId       String?
  submittedById    String?
  approvedAt       DateTime?
  approvedById     String?
  rejectionComment String?
  paidAt           DateTime?
  paidById         String?
  paymentReference String?
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  entries     PayrollEntry[]
  adjustments PayrollAdjustment[]

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, status])
}

/// Per-employee payroll snapshot. Never recalculated after approval (DB-frozen).
model PayrollEntry {
  id                  String   @id @default(cuid())
  organizationId      String
  periodId            String
  employeeId          String
  employeeNumber      String
  employeeName        String
  employeeNameAr      String?
  jobTitle            String?
  departmentName      String?
  departmentNameAr    String?
  compensationId      String?
  currency            String   @default("SAR")
  baseSalary          Decimal  @db.Decimal(14, 2)
  housingAllowance    Decimal  @default(0) @db.Decimal(14, 2)
  transportAllowance  Decimal  @default(0) @db.Decimal(14, 2)
  otherFixedAllowance Decimal  @default(0) @db.Decimal(14, 2)
  bonuses             Decimal  @default(0) @db.Decimal(14, 2)
  otherEarnings       Decimal  @default(0) @db.Decimal(14, 2)
  deductions          Decimal  @default(0) @db.Decimal(14, 2)
  grossPay            Decimal  @db.Decimal(14, 2)
  totalDeductions     Decimal  @db.Decimal(14, 2)
  netPay              Decimal  @db.Decimal(14, 2)
  /// component lines [{key, nameAr, nameEn, kind, amount, reason?}]
  lines               Json
  /// proration, unpaid leave, policy flags used
  calculationMeta     Json
  createdAt           DateTime @default(now())

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

model PayrollAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  periodId       String
  employeeId     String
  componentId    String
  amount         Decimal  @db.Decimal(14, 2)
  reason         String
  source         String?
  approvedById   String?
  createdById    String?
  createdAt      DateTime @default(now())

  period    PayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  employee  Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  component PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([periodId, employeeId])
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

model JobOpening {
  id             String         @id @default(cuid())
  organizationId String
  /// JOB-000001
  number         String
  title          String
  departmentId   String?
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  headcount      Int            @default(1)
  description    String?
  requirements   String?
  status         JobStatus      @default(DRAFT)
  ownerId        String?
  openedAt       DateTime?
  closedAt       DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  applications Application[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

enum CandidateSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  JOB_BOARD
  AGENCY
  OTHER
}

model Candidate {
  id              String          @id @default(cuid())
  organizationId  String
  /// CAN-000001
  number          String
  firstName       String
  lastName        String
  email           String?
  emailNormalized String?
  phone           String?
  linkedinUrl     String?
  source          CandidateSource @default(OTHER)
  notes           String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  archivedAt      DateTime?

  applications Application[]

  @@unique([organizationId, number])
  @@index([organizationId, emailNormalized])
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  TECHNICAL
  FINAL_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
}

model Application {
  id                String            @id @default(cuid())
  organizationId    String
  candidateId       String
  jobId             String
  stage             ApplicationStage  @default(APPLIED)
  status            ApplicationStatus @default(ACTIVE)
  ownerId           String?
  appliedAt         DateTime          @default(now())
  stageChangedAt    DateTime          @default(now())
  salaryExpectation Decimal?          @db.Decimal(14, 2)
  currency          String            @default("SAR")
  noticePeriodDays  Int?
  notes             String?
  rejectionReason   String?
  hiredEmployeeId   String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  candidate     Candidate             @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job           JobOpening            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  hiredEmployee Employee?             @relation("HiredEmployee", fields: [hiredEmployeeId], references: [id], onDelete: Restrict)
  interviews    Interview[]
  evaluations   CandidateEvaluation[]
  offers        Offer[]

  @@unique([candidateId, jobId])
  @@index([organizationId, jobId, stage])
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Interview {
  id              String          @id @default(cuid())
  organizationId  String
  applicationId   String
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  type            InterviewType   @default(VIDEO)
  interviewerIds  String[]
  location        String?
  status          InterviewStatus @default(SCHEDULED)
  notes           String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  evaluations CandidateEvaluation[]

  @@index([applicationId, scheduledAt])
}

enum Recommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

model CandidateEvaluation {
  id             String          @id @default(cuid())
  organizationId String
  applicationId  String
  interviewId    String?
  reviewerId     String
  criteria       String?
  rating         Int
  recommendation Recommendation?
  notes          String?
  createdAt      DateTime        @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interview   Interview?  @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Offer {
  id                  String      @id @default(cuid())
  organizationId      String
  /// OFR-000001
  number              String
  applicationId       String
  jobTitle            String
  salary              Decimal     @db.Decimal(14, 2)
  housingAllowance    Decimal     @default(0) @db.Decimal(14, 2)
  transportAllowance  Decimal     @default(0) @db.Decimal(14, 2)
  currency            String      @default("SAR")
  startDate           DateTime    @db.Date
  expiresAt           DateTime?   @db.Date
  status              OfferStatus @default(DRAFT)
  approvalId          String?
  approvedAt          DateTime?
  approvedById        String?
  sentAt              DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  withdrawnAt         DateTime?
  convertedEmployeeId String?     @unique
  convertedAt         DateTime?
  expiryNotifiedAt    DateTime?
  createdById         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  application       Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  convertedEmployee Employee?   @relation("OfferEmployee", fields: [convertedEmployeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([applicationId])
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  COMPLETED
  ACKNOWLEDGED
}

model PerformanceReview {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  reviewerId     String
  periodLabel    String
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  dueDate        DateTime?    @db.Date
  status         ReviewStatus @default(DRAFT)
  summary        String?
  /// 1–5, set when completed
  rating         Int?
  completedAt    DateTime?
  acknowledgedAt DateTime?
  dueNotifiedAt  DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  goals    PerformanceGoal[]

  @@index([organizationId, status])
  @@index([employeeId])
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  MISSED
  CANCELLED
}

model PerformanceGoal {
  id          String     @id @default(cuid())
  employeeId  String
  reviewId    String?
  title       String
  description String?
  status      GoalStatus @default(NOT_STARTED)
  weight      Int        @default(0)
  result      String?
  dueDate     DateTime?  @db.Date
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  review   PerformanceReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Phase 7 — Operations: procurement, purchase orders, receipts, assets,
// documents (secure storage + versions), support tickets + SLA, knowledge base.
// Procurement is not accounting: a PO never creates a payment or a liability.
// ---------------------------------------------------------------------------

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERING
  ORDERED
  RECEIVED
  CANCELLED
}

enum ProcurementApprover {
  /// the requester's line manager (Employee.manager → user), falls back to procurement approvers
  LINE_MANAGER
  /// the project manager of the request's project, falls back to procurement approvers
  PROJECT_MANAGER
  /// any holder of procurement.requests.approve
  PROCUREMENT
  /// any holder of procurement.requests.approve_executive
  EXECUTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum ReceiptCondition {
  GOOD
  DAMAGED
  INCORRECT
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_USE
  MAINTENANCE
  LOST
  DAMAGED
  RETIRED
  DISPOSED
}

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
  UPGRADE
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentCategory {
  COMPANY
  CLIENT
  CONTRACT
  PROJECT
  FINANCE
  HR
  VENDOR
  PROCUREMENT
  ASSET
  LEGAL
  OTHER
}

enum DocumentClassification {
  PUBLIC_INTERNAL
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentStatus {
  ACTIVE
  IN_REVIEW
  ARCHIVED
}

enum DocumentEntityType {
  CLIENT
  QUOTATION
  CONTRACT
  PROJECT
  INVOICE
  EXPENSE
  EMPLOYEE
  VENDOR
  PROCUREMENT_REQUEST
  PURCHASE_ORDER
  ASSET
  TICKET
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_INTERNAL
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketSource {
  INTERNAL
  CLIENT_RECORDED
  EMAIL_FUTURE
  WHATSAPP_FUTURE
  WEBSITE_FUTURE
  PHONE
  OTHER
}

enum TicketCategory {
  TECHNICAL
  BUG
  ACCESS
  CHANGE_REQUEST
  BILLING
  QUESTION
  OTHER
}

enum TicketCommentVisibility {
  INTERNAL
  /// marked for a future client portal — never sent anywhere today
  CLIENT_FACING
}

enum KnowledgeStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeVisibility {
  ALL_EMPLOYEES
  DEPARTMENT
  ROLE_RESTRICTED
  SUPPORT_ONLY
}

model VendorContact {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String
  name           String
  role           String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

/// Configurable procurement approval routing (first matching active rule by sortOrder).
model ProcurementApprovalRule {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int                 @default(0)
  minAmount      Decimal             @default(0) @db.Decimal(14, 2)
  /// exclusive upper bound; null = no limit
  maxAmount      Decimal?            @db.Decimal(14, 2)
  departmentId   String?
  /// null = any; true = only project requests; false = only non-project requests
  forProject     Boolean?
  category       String?
  approver       ProcurementApprover
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, active, sortOrder])
}

model ProcurementRequest {
  id                    String               @id @default(cuid())
  organizationId        String
  /// PR-YYYY-NNNNNN
  number                String
  requesterId           String
  departmentId          String?
  projectId             String?
  title                 String
  description           String?
  businessJustification String
  category              String?
  requestedDate         DateTime             @db.Date
  neededByDate          DateTime?            @db.Date
  /// server-calculated from the items
  estimatedAmount       Decimal              @default(0) @db.Decimal(14, 2)
  currency              String               @default("SAR")
  priority              Priority             @default(MEDIUM)
  status                ProcurementStatus    @default(DRAFT)
  preferredVendorId     String?
  approvalId            String?
  approvalRuleName      String?
  approver              ProcurementApprover?
  submittedAt           DateTime?
  approvedAt            DateTime?
  approvedById          String?
  rejectedAt            DateTime?
  rejectionReason       String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  department      Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  preferredVendor Vendor?                  @relation(fields: [preferredVendorId], references: [id], onDelete: Restrict)
  items           ProcurementRequestItem[]
  purchaseOrders  PurchaseOrder[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([requesterId])
  @@index([projectId])
}

model ProcurementRequestItem {
  id                 String  @id @default(cuid())
  requestId          String
  description        String
  quantity           Decimal @db.Decimal(12, 3)
  estimatedUnitPrice Decimal @db.Decimal(14, 2)
  estimatedTotal     Decimal @db.Decimal(14, 2)
  category           String?
  preferredVendorId  String?
  assetExpected      Boolean @default(false)
  projectId          String?
  departmentId       String?
  sortOrder          Int     @default(0)

  request ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  organizationId       String
  /// PO-YYYY-NNNNNN
  number               String
  vendorId             String
  procurementRequestId String?
  departmentId         String?
  projectId            String?
  currency             String              @default("SAR")
  status               PurchaseOrderStatus @default(DRAFT)
  issueDate            DateTime?           @db.Date
  expectedDeliveryDate DateTime?           @db.Date
  subtotal             Decimal             @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal             @default(0) @db.Decimal(14, 2)
  total                Decimal             @default(0) @db.Decimal(14, 2)
  terms                String?
  notes                String?
  createdById          String
  approvalId           String?
  approvedById         String?
  approvedAt           DateTime?
  /// approval waived: PO covered by its approved procurement request
  approvalWaivedReason String?
  issuedAt             DateTime?
  issuedById           String?
  receivedAt           DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  closedAt             DateTime?
  closeReason          String?
  /// cancel-and-replace: the PO this one replaces
  revisionOfId         String?             @unique
  overdueNotifiedAt    DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  procurementRequest ProcurementRequest? @relation(fields: [procurementRequestId], references: [id], onDelete: Restrict)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisionOf         PurchaseOrder?      @relation("PoRevision", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisedBy          PurchaseOrder?      @relation("PoRevision")
  items              PurchaseOrderItem[]
  receipts           PurchaseReceipt[]
  assets             Asset[]
  expenses           Expense[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([vendorId])
  @@index([procurementRequestId])
  @@index([projectId])
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  description      String
  quantity         Decimal @db.Decimal(12, 3)
  unitPrice        Decimal @db.Decimal(14, 2)
  discountAmount   Decimal @default(0) @db.Decimal(14, 2)
  taxRate          Decimal @default(15) @db.Decimal(5, 2)
  subtotal         Decimal @db.Decimal(14, 2)
  taxAmount        Decimal @db.Decimal(14, 2)
  total            Decimal @db.Decimal(14, 2)
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)
  assetExpected    Boolean @default(false)
  category         String?
  serviceId        String?
  projectId        String?
  sortOrder        Int     @default(0)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiptItems  PurchaseReceiptItem[]
  assets        Asset[]

  @@index([purchaseOrderId])
}

model PurchaseReceipt {
  id              String   @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  receivedById    String
  receivedAt      DateTime @db.Date
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId])
}

model PurchaseReceiptItem {
  id               String           @id @default(cuid())
  receiptId        String
  poItemId         String
  quantityReceived Decimal          @db.Decimal(12, 3)
  condition        ReceiptCondition @default(GOOD)
  notes            String?

  receipt PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poItem  PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Restrict)

  @@index([poItemId])
}

model AssetCategory {
  id                String   @id @default(cuid())
  organizationId    String
  key               String
  nameAr            String
  nameEn            String
  /// days before warranty end that raise "warranty expiring"
  warrantyAlertDays Int      @default(30)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  assets            Asset[]

  @@unique([organizationId, key])
}

model Asset {
  id                  String      @id @default(cuid())
  organizationId      String
  /// AST-000001
  number              String
  name                String
  categoryId          String
  serialNumber        String?
  manufacturer        String?
  model               String?
  purchaseOrderId     String?
  purchaseOrderItemId String?
  vendorId            String?
  purchaseDate        DateTime?   @db.Date
  purchaseCost        Decimal?    @db.Decimal(14, 2)
  currency            String?
  warrantyEndDate     DateTime?   @db.Date
  status              AssetStatus @default(IN_STOCK)
  location            String?
  assignedEmployeeId  String?
  notes               String?
  warrantyNotifiedAt  DateTime?
  createdById         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  archivedAt          DateTime?

  category          AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  vendor            Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assignedEmployee  Employee?          @relation(fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  assignments       AssetAssignment[]
  maintenance       AssetMaintenance[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([assignedEmployeeId])
  @@index([purchaseOrderItemId])
}

/// Append-only history: a row is closed once (returnedAt) and never deleted.
model AssetAssignment {
  id                    String    @id @default(cuid())
  organizationId        String
  assetId               String
  employeeId            String
  assignedAt            DateTime  @default(now())
  assignedById          String
  conditionAtAssignment String
  notes                 String?
  returnedAt            DateTime?
  returnedById          String?
  conditionAtReturn     String?
  returnNotes           String?

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([employeeId])
}

model AssetMaintenance {
  id                String            @id @default(cuid())
  organizationId    String
  assetId           String
  type              MaintenanceType   @default(REPAIR)
  description       String
  vendorId          String?
  scheduledDate     DateTime?         @db.Date
  startedAt         DateTime?
  completedDate     DateTime?         @db.Date
  cost              Decimal?          @db.Decimal(14, 2)
  currency          String            @default("SAR")
  status            MaintenanceStatus @default(SCHEDULED)
  /// asset status to restore when the maintenance ends
  assetStatusBefore AssetStatus?
  /// optional later link to the expense that paid for it (never auto-created)
  expenseId         String?
  dueNotifiedAt     DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  asset  Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([organizationId, status])
}

model Document {
  id                String                 @id @default(cuid())
  organizationId    String
  /// DOC-000001
  number            String
  title             String
  description       String?
  category          DocumentCategory
  entityType        DocumentEntityType?
  entityId          String?
  ownerId           String
  classification    DocumentClassification @default(INTERNAL)
  status            DocumentStatus         @default(ACTIVE)
  tags              String[]
  currentVersion    Int                    @default(0)
  reviewerId        String?
  reviewRequestedAt DateTime?
  reviewNotifiedAt  DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?

  versions DocumentVersion[]

  @@unique([organizationId, number])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status])
}

/// Immutable: a new upload is a new row; storageKey is never exposed to clients.
model DocumentVersion {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  versionNumber  Int
  storageKey     String   @unique
  sha256         String
  mime           String
  size           Int
  originalName   String
  /// status at upload (immutable): NOT_CONFIGURED / legacy NOT_SCANNED, PENDING, CLEAN — live result in DocumentVersionScan
  scanStatus     String   @default("NOT_SCANNED")
  note           String?
  uploadedById   String
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  /// Phase 8: storage driver that holds this version (local / s3) — old versions keep their driver
  storageDriver String @default("local")

  /// Phase 11: malware-scan result (the version row itself is immutable)
  scan DocumentVersionScan?

  @@unique([documentId, versionNumber])
}

/// Phase 11 (P11-C): malware-scan state of one document version (src/server/ops/scanner.ts).
/// status: PENDING | CLEAN | INFECTED | FAILED. Only ids, engine and detection name are stored — never file contents.
model DocumentVersionScan {
  id             String    @id @default(cuid())
  organizationId String
  versionId      String    @unique
  status         String
  scanner        String?
  attempts       Int       @default(0)
  lastErrorCode  String?
  signature      String?
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  scannedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  version DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([organizationId])
}

model SlaPolicy {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  priority             Priority
  firstResponseMinutes Int
  resolutionMinutes    Int
  /// warning when this share of the window has elapsed
  warnAtPercent        Int      @default(80)
  /// pause the resolution clock while WAITING_CLIENT (elapsed time only — no business-hours engine)
  pauseOnWaitingClient Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tickets SupportTicket[]

  @@index([organizationId, priority, active])
}

model SupportTicket {
  id                 String         @id @default(cuid())
  organizationId     String
  /// TCK-000001
  number             String
  clientId           String?
  contactId          String?
  projectId          String?
  serviceId          String?
  subject            String
  description        String
  category           TicketCategory @default(TECHNICAL)
  priority           Priority       @default(MEDIUM)
  status             TicketStatus   @default(NEW)
  assignedToId       String?
  createdById        String
  source             TicketSource   @default(INTERNAL)
  slaPolicyId        String?
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  pausedAt           DateTime?
  pausedMinutes      Int            @default(0)
  responseWarnedAt   DateTime?
  responseBreachedAt DateTime?
  slaWarnedAt        DateTime?
  slaBreachedAt      DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client    Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact   Contact?              @relation(fields: [contactId], references: [id], onDelete: Restrict)
  project   Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  service   Service?              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  slaPolicy SlaPolicy?            @relation(fields: [slaPolicyId], references: [id], onDelete: Restrict)
  comments  TicketComment[]
  history   TicketStatusHistory[]
  tags      TicketTag[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([clientId])
  @@index([projectId])
}

model TicketComment {
  id             String                  @id @default(cuid())
  organizationId String
  ticketId       String
  authorId       String
  body           String
  visibility     TicketCommentVisibility @default(INTERNAL)
  createdAt      DateTime                @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketStatusHistory {
  id          String        @id @default(cuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String?
  reason      String?
  createdAt   DateTime      @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketTag {
  id       String @id @default(cuid())
  ticketId String
  tag      String

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tag])
  @@index([tag])
}

model KnowledgeCategory {
  id             String             @id @default(cuid())
  organizationId String
  key            String
  nameAr         String
  nameEn         String
  sortOrder      Int                @default(0)
  active         Boolean            @default(true)
  articles       KnowledgeArticle[]

  @@unique([organizationId, key])
}

/// Working copy + pointer to the live (published) version. Readers only ever see a published version.
model KnowledgeArticle {
  id                 String              @id @default(cuid())
  organizationId     String
  /// KB-000001
  number             String
  titleAr            String
  titleEn            String
  bodyAr             String
  bodyEn             String
  categoryId         String
  status             KnowledgeStatus     @default(DRAFT)
  visibility         KnowledgeVisibility @default(ALL_EMPLOYEES)
  departmentId       String?
  roleKeys           String[]
  tags               String[]
  authorId           String
  reviewComment      String?
  reviewRequestedAt  DateTime?
  reviewNotifiedAt   DateTime?
  publishedAt        DateTime?
  publishedById      String?
  publishedVersionId String?             @unique
  currentVersion     Int                 @default(0)
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  category         KnowledgeCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department       Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  publishedVersion KnowledgeArticleVersion?  @relation("LiveVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions         KnowledgeArticleVersion[] @relation("ArticleVersions")

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

/// Immutable snapshot written on every publish.
model KnowledgeArticleVersion {
  id            String   @id @default(cuid())
  articleId     String
  version       Int
  titleAr       String
  titleEn       String
  bodyAr        String
  bodyEn        String
  publishedById String
  createdAt     DateTime @default(now())

  article KnowledgeArticle  @relation("ArticleVersions", fields: [articleId], references: [id], onDelete: Restrict)
  liveFor KnowledgeArticle? @relation("LiveVersion")

  @@unique([articleId, version])
}

// ---------------------------------------------------------------------------
// Phase 8 — Integrations, webhooks, outbox, WhatsApp Business Platform,
// marketing campaigns, consent and attribution. Nothing here fakes a provider:
// a connection is CONNECTED only after a real health check succeeded.
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  WHATSAPP
  GOOGLE
  GMAIL
  GOOGLE_CALENDAR
  GOOGLE_DRIVE
  META
  GOOGLE_ADS
  ZID
  SALLA
  SHOPIFY
  NOVA
  WEBHOOK
  CUSTOM
  S3
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  DEGRADED
  ERROR
  DISABLED
}

enum IntegrationEnvironment {
  PRODUCTION
  SANDBOX
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ExecutionStatus {
  SUCCEEDED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  DISMISSED
}

enum WebhookStatus {
  PROCESSED
  REJECTED
  FAILED
  IGNORED
}

enum WaDirection {
  INBOUND
  OUTBOUND
}

enum WaMessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WaMatchState {
  MATCHED
  AMBIGUOUS
  UNMATCHED
}

enum WaTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
  UNKNOWN
}

enum CampaignChannel {
  WHATSAPP
  META
  GOOGLE
  LINKEDIN
  TIKTOK
  EMAIL
  OTHER
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  SKIPPED
}

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
  PHONE
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
  BLOCKED
  UNKNOWN
}

enum SpendSource {
  MANUAL
  PROVIDER_SYNCED
}

enum TouchType {
  FIRST
  TOUCH
}

/// One configured connection to an external provider. Secrets are never stored here (see IntegrationSecret).
model IntegrationConnection {
  id                   String                 @id @default(cuid())
  organizationId       String
  provider             IntegrationProvider
  name                 String
  status               IntegrationStatus      @default(NOT_CONFIGURED)
  environment          IntegrationEnvironment @default(PRODUCTION)
  /// non-secret settings only (ids, URLs, subscribed events)
  config               Json                   @default("{}")
  /// secret name → reference ("env:VAR" or "enc:<IntegrationSecret.id>") — never the value
  secretRefs           Json                   @default("{}")
  lastHealthCheckAt    DateTime?
  lastHealthResult     String?
  lastSuccessfulSyncAt DateTime?
  lastFailureAt        DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?
  credentialsExpireAt  DateTime?
  disabledAt           DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  secrets       IntegrationSecret[]
  executions    IntegrationExecution[]
  webhookEvents WebhookEvent[]

  @@unique([organizationId, provider, name])
  @@index([organizationId, status])
}

/// AES-256-GCM encrypted secret (master key from INTEGRATION_MASTER_KEY). Plaintext never leaves the server.
model IntegrationSecret {
  id             String    @id @default(cuid())
  organizationId String
  connectionId   String
  name           String
  ciphertext     String
  iv             String
  authTag        String
  keyVersion     Int       @default(1)
  createdAt      DateTime  @default(now())
  rotatedAt      DateTime?

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, name])
}

/// One attempt of an integration action (health check, send, sync, webhook processing). Sanitized only.
model IntegrationExecution {
  id                String               @id @default(cuid())
  organizationId    String
  connectionId      String?
  provider          IntegrationProvider
  direction         IntegrationDirection
  action            String
  externalReference String?
  status            ExecutionStatus
  attempts          Int                  @default(1)
  startedAt         DateTime             @default(now())
  completedAt       DateTime?
  errorCode         String?
  sanitizedError    String?
  metadata          Json?
  outboxId          String?

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([organizationId, status])
}

/// Inbound webhook delivery. (organizationId, provider, externalEventId) is unique → business logic runs once.
model WebhookEvent {
  id              String              @id @default(cuid())
  organizationId  String
  connectionId    String?
  provider        IntegrationProvider
  externalEventId String
  eventType       String
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?
  status          WebhookStatus
  payloadHash     String
  signatureValid  Boolean
  error           String?
  /// sanitized metadata (counts, ids) — never the raw payload or headers
  metadata        Json?
  duplicateCount  Int                 @default(0)

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, externalEventId])
  @@index([organizationId, status, receivedAt])
}

/// Transactional outbox: written in the business transaction, delivered by the worker after commit.
model IntegrationOutbox {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  connectionId   String?
  eventType      String
  entityType     String?
  entityId       String?
  payload        Json
  /// business idempotency key — the same work is never queued twice
  idempotencyKey String
  status         OutboxStatus        @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(6)
  nextAttemptAt  DateTime            @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastErrorCode  String?
  lastError      String?
  completedAt    DateTime?
  deadAt         DateTime?
  dismissedAt    DateTime?
  dismissedById  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  /// Phase 10: request / causal-chain correlation (trace an HTTP request → event → automation → outbox)
  correlationId  String?

  @@unique([organizationId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId, status])
}

model WhatsAppConversation {
  id             String       @id @default(cuid())
  organizationId String
  connectionId   String?
  /// WhatsApp id = normalized phone (digits, country code)
  waId           String
  profileName    String?
  matchState     WaMatchState @default(UNMATCHED)
  /// ambiguous candidates [{type,id,label}] — shown to the operator, never auto-merged
  candidates     Json?
  leadId         String?
  contactId      String?
  clientId       String?
  ticketId       String?
  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages WhatsAppMessage[]

  @@unique([organizationId, waId])
  @@index([organizationId, lastMessageAt])
}

model WhatsAppMessage {
  id                  String          @id @default(cuid())
  organizationId      String
  conversationId      String
  direction           WaDirection
  providerMessageId   String?
  messageType         String
  body                String?
  /// sanitized metadata (template name, media id / mime — media itself is never stored publicly)
  metadata            Json?
  status              WaMessageStatus
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedAt            DateTime?
  errorCode           String?
  campaignRecipientId String?
  createdById         String?
  createdAt           DateTime        @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerMessageId])
  @@index([conversationId, createdAt])
}

/// Local mirror of provider templates. Status always comes from the provider (sync / webhook).
model WhatsAppTemplate {
  id                 String           @id @default(cuid())
  organizationId     String
  connectionId       String?
  providerTemplateId String?
  name               String
  language           String
  category           String?
  status             WaTemplateStatus @default(UNKNOWN)
  components         Json?
  syncedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  campaigns MarketingCampaign[]

  @@unique([organizationId, name, language])
}

/// Append-only consent history per address and channel; the latest row is the current state.
model ContactConsent {
  id             String         @id @default(cuid())
  organizationId String
  channel        ConsentChannel
  /// normalized phone / lower-case email
  address        String
  status         ConsentStatus
  source         String
  note           String?
  leadId         String?
  contactId      String?
  recordedById   String?
  recordedAt     DateTime       @default(now())

  @@index([organizationId, channel, address, recordedAt])
}

model MarketingCampaign {
  id                 String          @id @default(cuid())
  organizationId     String
  /// CMP-000001
  number             String
  name               String
  channel            CampaignChannel
  objective          String?
  budget             Decimal?        @db.Decimal(14, 2)
  currency           String          @default("SAR")
  startDate          DateTime?       @db.Date
  endDate            DateTime?       @db.Date
  ownerId            String
  status             CampaignStatus  @default(DRAFT)
  externalCampaignId String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  /// WhatsApp: the approved template (required for business-initiated messages)
  templateId         String?
  templateParams     Json?
  /// every content / audience change bumps the version; approvals are bound to it
  version            Int             @default(1)
  requireOptIn       Boolean         @default(true)
  sendRatePerMinute  Int             @default(30)
  approvalId         String?
  approvedVersion    Int?
  approvedSnapshot   Json?
  recipientCount     Int             @default(0)
  scheduledAt        DateTime?
  startedAt          DateTime?
  pausedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  failedAt           DateTime?
  failureReason      String?
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  template   WhatsAppTemplate?   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  audience   CampaignAudience?
  recipients CampaignRecipient[]
  messages   CampaignMessage[]
  spend      CampaignSpend[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, utmCampaign])
}

/// Audience definition (CRM filters). Recipients are snapshotted from it when the campaign starts.
model CampaignAudience {
  id             String    @id @default(cuid())
  campaignId     String    @unique
  filter         Json
  estimatedCount Int       @default(0)
  eligibleCount  Int       @default(0)
  computedAt     DateTime?

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  phone             String
  name              String?
  leadId            String?
  contactId         String?
  clientId          String?
  status            RecipientStatus @default(PENDING)
  skipReason        String?
  providerMessageId String?
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  repliedAt         DateTime?
  failedAt          DateTime?
  errorCode         String?
  createdAt         DateTime        @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages CampaignMessage[]

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([providerMessageId])
}

/// One send of one campaign version to one recipient — the unique key makes a duplicate send impossible.
model CampaignMessage {
  id             String   @id @default(cuid())
  campaignId     String
  recipientId    String
  messageVersion Int
  outboxId       String?
  waMessageId    String?
  createdAt      DateTime @default(now())

  campaign  MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([campaignId, recipientId, messageVersion])
}

model CampaignSpend {
  id           String      @id @default(cuid())
  campaignId   String
  date         DateTime    @db.Date
  amount       Decimal     @db.Decimal(14, 2)
  currency     String      @default("SAR")
  source       SpendSource @default(MANUAL)
  note         String?
  recordedById String?
  createdAt    DateTime    @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

/// Append-only acquisition history of a lead. The FIRST touch is never overwritten; later touches are added.
model AttributionTouch {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  touchType      TouchType
  source         String
  medium         String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?
  landingPage    String?
  campaignId     String?
  occurredAt     DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, campaignId])
  @@index([leadId, occurredAt])
}

// ---------------------------------------------------------------------------------------------
// Phase 9 — deterministic business rules, job registry, backups
// ---------------------------------------------------------------------------------------------

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  DEAD_LETTER
  DISMISSED
}

/// A deterministic rule: trigger (existing domain event) → conditions (validated JSON tree) → actions (allow-listed).
model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  enabled        Boolean  @default(false)
  triggerEvent   String
  /// { all|any: [ {field, op, value} | nested group ] } — validated against the trigger's field catalog
  conditions     Json
  /// [ {type, ...params} ] — allow-listed action types only
  actions        Json
  /// ORGANIZATION (only scope in this build)
  scope          String   @default("ORGANIZATION")
  /// lower runs first; ties broken by createdAt then id (deterministic order)
  priority       Int      @default(100)
  /// current version; every content change creates a new immutable AutomationRuleVersion
  version        Int      @default(1)
  /// template key when created from a built-in template
  templateKey    String?
  /// actions run with this user's CURRENT permissions (minus high-risk ones)
  runAsUserId    String
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions   AutomationRuleVersion[]
  executions AutomationExecution[]

  @@index([organizationId, triggerEvent, enabled])
}

/// Immutable snapshot of a rule version — executions reference it so history keeps its meaning.
model AutomationRuleVersion {
  id           String   @id @default(cuid())
  ruleId       String
  version      Int
  triggerEvent String
  conditions   Json
  actions      Json
  runAsUserId  String
  createdById  String
  createdAt    DateTime @default(now())

  rule       AutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  executions AutomationExecution[]

  @@unique([ruleId, version])
}

model AutomationExecution {
  id              String                    @id @default(cuid())
  organizationId  String
  ruleId          String
  ruleVersionId   String
  domainEventId   String
  eventType       String
  entityType      String?
  entityId        String?
  correlationId   String?
  depth           Int                       @default(0)
  status          AutomationExecutionStatus @default(PENDING)
  attempts        Int                       @default(0)
  maxAttempts     Int                       @default(5)
  nextAttemptAt   DateTime                  @default(now())
  /// entity values the conditions were evaluated against (sanitized, allow-listed fields only)
  input           Json?
  conditionResult Boolean?
  /// per action: {type, status, ref?, error?} — completed actions are not repeated on retry
  actionResults   Json?
  skipReason      String?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  dismissedAt     DateTime?
  dismissedById   String?
  dismissReason   String?
  createdAt       DateTime                  @default(now())

  rule        AutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleVersion AutomationRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  /// idempotency: one domain event never executes the same rule twice
  @@unique([ruleId, domainEventId])
  @@index([organizationId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([ruleId, correlationId])
}

enum JobRunStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

/// Operational job registry (one row per lease key): last run, duration, heartbeat. Visibility only — leases stay in JobLease.
model SystemJob {
  key             String       @id
  name            String
  status          JobRunStatus @default(IDLE)
  holder          String?
  lastStartedAt   DateTime?
  lastCompletedAt DateTime?
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastDurationMs  Int?
  lastError       String?
  heartbeatAt     DateTime?
  runCount        Int          @default(0)
  failCount       Int          @default(0)
  /// consecutive failures (reset on success) — drives alerts
  failStreak      Int          @default(0)
  updatedAt       DateTime     @updatedAt
}

enum BackupStatus {
  STARTED
  COMPLETED
  FAILED
  VERIFIED
  VERIFY_FAILED
}

/// Backup runs written by `npm run db:backup` / `db:verify-backup` (metadata only — never credentials).
model BackupRecord {
  id           String       @id @default(cuid())
  kind         String       @default("database")
  status       BackupStatus
  fileName     String?
  sizeBytes    BigInt?
  sha256       String?
  /// database name, server version, migrations, row counts (no host / user / password)
  metadata     Json?
  error        String?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  verifiedAt   DateTime?
  verifyDetail Json?

  @@index([kind, startedAt])
}

/// Phase 10: which deployment environment this database belongs to (written once by bootstrap). The app refuses to be
/// ready when APP_ENV differs — a staging app can never run against the production database (or the reverse).
model DeploymentMarker {
  id          Int      @id @default(1)
  environment String
  createdAt   DateTime @default(now())
}
