# /etc/dms-os/app.env (STAGING — separate database, bucket, keys and WhatsApp SANDBOX connections) — values come from the secret manager; never commit real values.
NODE_ENV=production
APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging-os.example.sa
# managed PostgreSQL, TLS required
DATABASE_URL=postgresql://dms_app:<secret>@<host>:5432/dms_os_staging?sslmode=require
# keys: base64 of 32 random bytes each (openssl rand -base64 32) — two DIFFERENT keys, backed up separately
INTEGRATION_MASTER_KEY=<secret>
HR_FIELD_KEY=<secret>
HR_FIELD_KEY_VERSION=1
# durable document storage (preferred: S3-compatible, private, versioned, encrypted)
DOCUMENT_STORAGE=s3
S3_ENDPOINT=https://<s3-endpoint>
S3_REGION=<region>
S3_BUCKET=<private-bucket>
S3_ACCESS_KEY_ID=<secret>
S3_SECRET_ACCESS_KEY=<secret>
S3_FORCE_PATH_STYLE=false
STORAGE_BACKUP_POLICY=<e.g. "S3 versioning on, noncurrent 90 d, CRR to <region>">
# operations
REQUIRE_WORKER=1
BACKUP_DIR=/var/lib/dms-os/backups
VERIFY_DATABASE_URL=postgresql://<verify-user>:<secret>@<non-production-host>:5432/postgres?sslmode=require
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_MAX_AGE_HOURS=26
PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump
PG_RESTORE_PATH=/usr/lib/postgresql/18/bin/pg_restore
RETENTION_DRY_RUN=0
LOG_DIR=/var/log/dms-os
# observability (one of)
SENTRY_DSN=
ERROR_REPORT_WEBHOOK_URL=
# decisions / attestations (go-live:check BLOCKs without them)
DB_ENCRYPTION_AT_REST=<provider + setting / ticket reference>
ZATCA_STATUS=NOT_CONFIGURED
ZATCA_DECISION_REF=
ANTIVIRUS_DECISION=
# optional
NOVA_URL=
