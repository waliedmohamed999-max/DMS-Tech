# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://dms1t.com

# Website quote/contact requests are stored as CRM leads in the Business OS database
# (DATABASE_URL below). The former Supabase variables are no longer used.

# ---- Business OS ----
# PostgreSQL connection (Supabase / Neon / RDS in production)
DATABASE_URL=
# Separate database used by `npm test` (never point at production)
TEST_DATABASE_URL=
# Set to 1 only on development machines to allow `npm run db:seed` (demo data)
ALLOW_DEMO_SEED=

# ---- Integrations ----
# NOVA AI is a separate external DMS Tech platform (docs/NOVA-INTEGRATION.md).
# https URL users are sent to from "Open NOVA". Leave empty until NOVA is reachable.
NOVA_URL=
