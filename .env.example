# DMS Tech — environment variable NAMES (no values, no secrets).
# cPanel: copy the names you need into  Setup Node.js App → (application) → Environment variables.
# Authoritative validation: src/server/system/config.ts (the server refuses to start on a critical error).
# Full reference: docs/CPANEL_DEPLOYMENT.md#environment-variables, deploy/env/production.env.example

# ---------------------------------------------------------------------------------------------------------------
# 1. BUILD TIME — must be set BEFORE `npm run cpanel:build` (compiled into the bundles; changing it needs a rebuild)
# ---------------------------------------------------------------------------------------------------------------
# public https URL of the site (production: https://dmstech.sa). Also read at runtime.
NEXT_PUBLIC_SITE_URL=
# optional: commit SHA for build metadata when `git` is not available to the build
GIT_COMMIT=
# optional: Next.js build workers (npm run cpanel:build defaults to 2 — keeps the build inside shared-hosting limits)
NEXT_BUILD_CPUS=

# ---------------------------------------------------------------------------------------------------------------
# 2. RUNTIME — REQUIRED in production (missing → "startup_refused" in the Passenger log)
# ---------------------------------------------------------------------------------------------------------------
# set by cPanel "Application mode: Production"
NODE_ENV=
# development | test | staging | production
APP_ENV=
# PostgreSQL connection string (postgresql://…, TLS for remote hosts) — secret
DATABASE_URL=
# base64 of 32 random bytes (openssl rand -base64 32); encrypts employee bank fields — secret, back it up separately
HR_FIELD_KEY=
# local | s3
DOCUMENT_STORAGE=
# DOCUMENT_STORAGE=local: absolute private directory OUTSIDE public_html and outside the repository
DOCUMENT_STORAGE_DIR=
# DOCUMENT_STORAGE=s3: all five required — secrets
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------------------------
# 3. OPTIONAL (runtime)
# ---------------------------------------------------------------------------------------------------------------
# integration secret store key: base64 of 32 bytes, must differ from HR_FIELD_KEY — secret (recommended)
INTEGRATION_MASTER_KEY=
HR_FIELD_KEY_VERSION=
HR_FIELD_KEY_PREVIOUS=
S3_FORCE_PATH_STYLE=
STORAGE_BACKUP_POLICY=
DOCUMENT_MAX_BYTES=
# NOVA AI is an external platform (docs/NOVA-INTEGRATION.md); https URL or empty
NOVA_URL=
# debug | info | warn | error | silent
LOG_LEVEL=
LOG_DIR=
# error reporting (one of) — secrets
SENTRY_DSN=
ERROR_REPORT_WEBHOOK_URL=
ERROR_REPORT_WEBHOOK_TOKEN=
ERROR_REPORT_SAMPLE_RATE=
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERT_WEBHOOK_FAILURES=
ALERT_QUEUE_BACKLOG=
# document malware scanning: none | clamd | http
DOCUMENT_SCANNER=
DOCUMENT_SCANNER_URL=
DOCUMENT_SCANNER_TOKEN=
CLAMD_HOST=
CLAMD_PORT=
# required | optional
DOCUMENT_SCAN_POLICY=
# background worker (cron `npm run worker`): 1 = /api/ready fails when its heartbeat is stale
REQUIRE_WORKER=
WORKER_INTERVAL_MS=
# backups (npm run db:backup) — directory outside public_html
BACKUP_DIR=
BACKUP_MAX_AGE_HOURS=
BACKUP_ENGINE=
BACKUP_KEEP_DAILY=
BACKUP_KEEP_WEEKLY=
BACKUP_KEEP_MONTHLY=
PG_DUMP_PATH=
PG_RESTORE_PATH=
VERIFY_DATABASE_URL=
RETENTION_DRY_RUN=
STORAGE_HEALTH_WRITE=
OS_ORG_SLUG=
# go-live attestations (npm run go-live:check)
DB_ENCRYPTION_AT_REST=
DB_PITR_EVIDENCE=
ANTIVIRUS_DECISION=
HTTP_BASE_URL=
# ZATCA e-invoicing (docs/ZATCA.md)
ZATCA_STATUS=
ZATCA_DECISION_REF=
ZATCA_API_BASE_URL=
ZATCA_SUPPLY_DATE_POLICY=
# app.js only when NOT under Passenger (Passenger supplies its own socket and ignores these)
PORT=
HOST=

# ---------------------------------------------------------------------------------------------------------------
# 4. ONE-OFF (set only while running the script, then remove)
# ---------------------------------------------------------------------------------------------------------------
# npm run os:bootstrap — first super admin
OS_ADMIN_EMAIL=
OS_ADMIN_NAME=
OS_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------
# 5. DEVELOPMENT ONLY — never set in production (config validation flags them)
# ---------------------------------------------------------------------------------------------------------------
ALLOW_DEMO_SEED=
TEST_DATABASE_URL=
OS_LOCAL_PROD_TEST=

# Public (NEXT_PUBLIC_*) variables: only NEXT_PUBLIC_SITE_URL. Never give a secret a NEXT_PUBLIC_ name — it would be
# shipped to every browser.
